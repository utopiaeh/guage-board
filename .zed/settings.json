{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "target": "xtensa-esp32s3-none-elf",
          "extraEnv": {
            "RUSTUP_TOOLCHAIN": "esp",
          },
        },
        "check": {
          "allTargets": false,
          "command": "check",
          "extraArgs": ["--target", "xtensa-esp32s3-none-elf"],
        },
      },
    },
  },
}
